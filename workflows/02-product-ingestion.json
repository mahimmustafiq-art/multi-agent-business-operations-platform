      "id": "39625e86-8c18-4dd9-b2bb-1d8fa1475c7d",
      "name": "Mistral Embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -656,
        112
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "mistralCloudApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Mistral Cloud account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validate Products').first().json;\nconst ai = $input.first().json;\nconst data = ai.data;\nif (!Array.isArray(data) || data.length !== v.rows.length) {\n  throw new Error('Embedding count mismatch: expected ' + v.rows.length);\n}\nconst now = new Date().toISOString();\nconst rows = v.rows.map((r, i) => {\n  const e = data[i].embedding;\n  if (!Array.isArray(e) || e.length !== 1024) throw new Error('Unexpected embedding dimension for ' + r.sku);\n  return Object.assign({}, r, { embedding: e, updated_at: now });\n});\nreturn [{ json: { rows, supabase_url: v.supabase_url } }];"
      },
      "id": "09fd705d-7612-42cf-8282-aef58d8beeb6",
      "name": "Attach Embeddings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
