    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst list = Array.isArray(body.products) ? body.products : [];\nconst errors = [];\nif (list.length === 0) errors.push('products array is required and must not be empty');\nif (list.length > 50) errors.push('maximum 50 products per request');\nconst rows = [];\nconst texts = [];\nlist.slice(0, 50).forEach((p, i) => {\n  const tag = 'products[' + i + ']';\n  const sku = String(p.sku || '').trim();\n  const name = String(p.name || '').trim();\n  if (!sku) errors.push(tag + '.sku is required');\n  if (!name) errors.push(tag + '.name is required');\n  let price = null;\n  if (p.price !== undefined && p.price !== null && p.price !== '') {\n    price = Number(p.price);\n    if (!Number.isFinite(price) || price < 0) { errors.push(tag + '.price must be a number >= 0'); price = null; }\n  }\n  let stockQty = null;\n  if (p.stock_quantity !== undefined && p.stock_quantity !== null && p.stock_quantity !== '') {\n    stockQty = Number(p.stock_quantity);\n    if (!Number.isInteger(stockQty) || stockQty < 0) { errors.push(tag + '.stock_quantity must be an integer >= 0'); stockQty = null; }\n  }\n  const specs = (p.specs && typeof p.specs === 'object') ? p.specs : {};\n  const row = {\n    sku, name,\n    description: p.description ? String(p.description) : null,\n    category: p.category ? String(p.category) : null,\n    price,\n    currency: p.currency ? String(p.currency) : null,\n    in_stock: typeof p.in_stock === 'boolean' ? p.in_stock : null,\n    stock_quantity: stockQty,\n    specs\n  };\n  rows.push(row);\n  texts.push([name, row.category, row.description, Object.keys(specs).length ? JSON.stringify(specs) : null].filter(Boolean).join('. '));\n});\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors, rows, texts,\n  supabase_url: String(item.supabase_url || '').replace(/\\/+$/, ''),\n  embed_model: item.embed_model\n} }];"
      },
