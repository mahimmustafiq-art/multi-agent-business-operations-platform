        "url": "={{ $json.supabase_url }}/rest/v1/products?on_conflict=sku&select=id,sku,name",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
