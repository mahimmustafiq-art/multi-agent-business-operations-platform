    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nreturn [{ json: {\n  meter_id: $('Create Meter').first().json.id,\n  meter_event_name: $('Create Meter').first().json.event_name,\n  product_id: $('Create Product').first().json.id,\n  price_id: $('Create Price').first().json.id,\n  price_lookup_key: $('Create Price').first().json.lookup_key,\n  customers_linked: rows.length,\n  customers: rows.map(r => ({ external_id: r.external_id, stripe_customer_id: r.stripe_customer_id, stripe_subscription_id: r.stripe_subscription_id }))\n} }];"
      },
