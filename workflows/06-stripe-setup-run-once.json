      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/customers?id=eq.{{ $json.metadata.supabase_customer_id }}&select=id,external_id,stripe_customer_id,stripe_subscription_id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stripe_customer_id: $json.customer, stripe_subscription_id: $json.id }) }}",
        "options": {}
      },
      "id": "afb8bca3-b417-41bb-b7e7-a2ffbaa9168d",
